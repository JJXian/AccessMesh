APP_ENV=development
APP_NAME=AccessMesh
API_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://accessmesh:accessmesh@postgres:5432/accessmesh
OPA_URL=http://opa:8181
OPA_DECISION_PATH=/v1/data/accessmesh/decision
DEMO_IDENTITY_ENABLED=true
DEFAULT_DEMO_SUBJECT_ID=user-requester
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# 默认不读取系统代理，避免本地 SOCKS 配置缺少依赖时影响模型调用。
LLM_TRUST_ENV=false
VITE_API_BASE_URL=/api/v1
